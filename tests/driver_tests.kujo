test_setup { from src.provider import zai_provider, zai_driver }
test "driver contract" { p := zai_provider({"model": "glm-4.5"}); d := zai_driver(); assert_equal(d["version"], "1.0.0"); assert_equal(d["encode_chat"]({"provider": p, "messages": [], "resolved_options": {}})["url"], "https://api.z.ai/api/paas/v4/chat/completions") }

test "driver preserves tool-turn history and GLM reasoning controls" {
    provider := zai_provider({"model":"m"})
    driver := zai_driver()
    messages := [
        {"role":"assistant","content":null,"reasoning_content":"plan","tool_calls":[{"id":"call-a"}]},
        {"role":"tool","content":"result","tool_call_id":"call-a"},
    ]
    request := driver["encode_chat"]({
        "provider":provider,"credential":"fixture-key","messages":messages,
        "options":{"reasoning_effort":"high","thinking":{"type":"enabled"},"tool_stream":true,"request_id":"fixture-request"},
        "resolved_options":{"model":"m","stream":true},
        "payload":{"messages":messages,"stream":true},
    })
    body := parse_json(request["body"])
    assert_equal(body["messages"],messages)
    assert_equal(body["reasoning_effort"],"high")
    assert_equal(body["thinking"],{"type":"enabled"})
    assert_equal(body["tool_stream"],true)
    assert_equal(body["request_id"],"fixture-request")
    assert_equal(request["headers"]["Authorization"],"Bearer fixture-key")
    assert_equal(request["url"],"https://api.z.ai/api/paas/v4/chat/completions")
    assert_equal(request["headers"]["Accept"],"text/event-stream")
    assert_equal(driver["validate"]({"base_url":"https:///"})["ok"],false)
}

test "driver retains reasoning and null text on a tool-only completion" {
    message := {"content":null,"reasoning_content":"plan","tool_calls":[{"id":"call-a"}]}
    decode := zai_driver()["decode_chat"]
    decoded := decode({"data":{"choices":[{"message":message,"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":4,"completion_tokens":2}}})
    assert_equal(decoded["output_text"],"")
    assert_equal(decoded["tool_calls"],message["tool_calls"])
    assert_equal(decoded["raw_provider"]["choices"][0]["message"]["reasoning_content"],"plan")
    assert_equal(decoded["usage"]["total_tokens"],6)
    assert_equal(decode({"data":{"choices":[]}})["ok"],false)
    assert_equal(decode({"data":{"error":{"message":"unavailable"}}})["ok"],false)
}

test "stream stitches interleaved tool deltas and keeps usage and reasoning evidence" {
    events := [
        {"id":"task-a","request_id":"chat-a","model":"m","choices":[{"delta":{"reasoning_content":"plan","tool_calls":[{"index":1,"id":"second","function":{"name":"second","arguments":"b"}}]}}]},
        {"choices":[{"delta":{"content":"Hi","tool_calls":[{"index":0,"id":"first","function":{"name":"first","arguments":"a"}},{"index":1,"function":{"arguments":"2"}}]}}]},
        {"choices":[{"finish_reason":"tool_calls","delta":{"tool_calls":[{"index":0,"function":{"arguments":"1"}}]}}]},
        {"choices":[],"usage":{"prompt_tokens":4,"completion_tokens":2,"total_tokens":6}},
    ]
    frames := []
    for event in events { frames = push(frames,"data: "+to_json(event)+"\r\n\r\n") }
    finish := "data: [DONE]\r\n\r\n"
    decode := zai_driver()["decode_stream"]
    result := decode({"chunks":push(frames,finish),"fallback_model":"fallback"})
    assert_true(result["ok"])
    assert_equal(result["request_id"],"chat-a")
    assert_equal(result["model"],"m")
    assert_equal(result["output_text"],"Hi")
    assert_equal(result["finish_reason"],"tool_calls")
    assert_equal(result["tool_calls"][0]["function"]["arguments"],"a1")
    assert_equal(result["tool_calls"][1]["function"]["arguments"],"b2")
    assert_equal(result["usage"]["total_tokens"],6)
    assert_equal(result["raw_provider"]["stream_events"],events)
    assert_equal(decode({"chunks":frames})["ok"],false)
    assert_equal(decode({"chunks":[frames[0],finish]})["ok"],false)
}

test "driver decodes the documented Z.ai error envelope" {
    decode := zai_driver()["decode_error"]
    result := decode({"status_code":429,"data":{"code":1302,"message":"Too many requests"}})
    assert_true(result["matched"])
    assert_equal(result["category"],"rate_limit")
    assert_equal(result["provider_code"],1302)
    assert_equal(result["message"],"Too many requests")
    result = decode({"status_code":401,"data":{"error":{"code":"1002","message":"Invalid token"}}})
    assert_equal(result["category"],"auth")
    assert_equal(result["provider_code"],"1002")
}

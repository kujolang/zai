# Native Z.ai Chat Completions.
ZAI_BASE := "https://api.z.ai/api/paas/v4"
DEFAULT_MODEL := "glm-4.5"
BODY_LIMIT := 8388608

func get(value, key, fallback) {
    if type(value) == "dict" && has_key(value,key) { return value[key] }
    return fallback
}

func endpoint(value) {
    if type(value) != "string" { return "" }
    url := trim(value)
    if regex_match(url,"[\\x00-\\x20\\x7f@?#\\\\]") { return "" }
    if !regex_match(lower(url),"^https://(?:[a-z0-9][a-z0-9.-]*|\\[[0-9a-f:.]+\\])(?::[0-9]{1,5})?(?:/[a-z0-9._~/-]*)?$") { return "" }
    for part in split(url,"/") {
        if part == "." || part == ".." { return "" }
    }
    port := regex_find_all(split(url,"/")[2],":[0-9]{1,5}$")
    if len(port) > 0 {
        number := to_int(substring(port[0],1,len(port[0])))
        if number < 1 || number > 65535 { return "" }
    }
    return regex_replace(url,"/+$","")
}

func redact(text, key) {
    if type(text) == "string" && key != "" { return replace(text,key,"[REDACTED]") }
    return text
}

func redact_value(value, key) {
    if key == "" { return value }
    if type(value) == "string" { return redact(value,key) }
    if type(value) != "dict" && type(value) != "array" { return value }
    encoded := to_json(value)
    key_literal := to_json(key)
    if contains(encoded,substring(key_literal,1,len(key_literal)-1)) == 0 { return value }

    // Re-encode just the JSON strings so numeric values and arrays retain their types.
    pattern := "\"(?:[^\"\\\\]|\\\\.)*\""
    literals := regex_split(encoded,pattern)
    tokens := regex_find_all(encoded,pattern)
    segments := range(0,2*len(tokens)+1)
    for index in range(0,len(tokens)) {
        segments[2*index] = literals[index]
        segments[2*index+1] = to_json(redact(parse_json(tokens[index]),key))
    }
    segments[len(segments)-1] = literals[len(literals)-1]
    return parse_json(join(segments,""))
}

func decode_json(body) {
    if type(body) != "string" || byte_length(body) > BODY_LIMIT { return null }
    try { return parse_json(body) } except error { return null }
}

func provider_error(value) {
    if type(value) != "dict" { return false }
    if get(value,"error",null) != null { return true }
    return has_key(value,"code") && type(get(value,"message",null)) == "string" && has_key(value,"choices") == 0
}

func failure_message(value) {
    error := get(value,"error",null)
    if type(error) == "string" && error != "" { return error }
    message := get(error,"message",get(value,"message",""))
    if type(message) == "string" && message != "" { return message }
    return "Z.ai request failed."
}

func create_client_impl(config) {
    base := endpoint(get(config,"base_url",ZAI_BASE))
    key := get(config,"api_key",null)
    if key == null { key = env("ZAI_API_KEY") }
    if type(key) != "string" { key = "" }
    problem := ""
    if base == "" { problem = "Z.ai base URL must be HTTPS." }
    return {
        "base_url":base,"api_key":key,"model":get(config,"model",DEFAULT_MODEL),"timeout":get(config,"timeout",60.0),
        "transport":get(config,"transport",null), "validation_error":problem,
    }
}

func chat_impl(client, options) {
    base := endpoint(get(client,"base_url",""))
    if base == "" { return {"ok":false,"message":"Z.ai base URL must be HTTPS."} }
    key := get(client,"api_key","")
    if type(key) != "string" || key == "" || regex_match(key,"[\\x00-\\x20\\x7f]") {
        return {"ok":false,"message":"Z.ai API key is required and must be a valid bearer value."}
    }
    timeout := get(client,"timeout",60.0)
    if (type(timeout) != "int" && type(timeout) != "float") || timeout <= 0 || timeout-timeout != 0 {
        return {"ok":false,"message":"Z.ai timeout must be a positive finite number."}
    }
    if type(options) != "dict" { return {"ok":false,"message":"Z.ai request must be an object."} }
    payload := merge({"model":get(client,"model",DEFAULT_MODEL)},options)
    streaming := get(payload,"stream",false) == true
    headers := {"Authorization":"Bearer "+key,"Content-Type":"application/json"}
    if streaming { headers["Accept"] := "text/event-stream" }
    transport := get(client,"transport",null)
    if type(transport) != "function" { transport = http_request }
    response := transport(base+"/chat/completions",{
        "method":"POST","timeout":timeout,"redirects":"none","max_response_bytes":BODY_LIMIT,
        "_headers":headers,"_body":to_json(payload),
    })
    match response {
        case Err(error): { return {"ok":false,"message":redact(to_string(error),key)} }
        case Ok(wire): { return decode_response(wire,streaming,key) }
    }
}

func decode_response(wire, streaming, key) {
    if type(wire) != "dict" { return {"ok":false,"message":"Z.ai returned an invalid HTTP response."} }
    response := merge({},wire)
    status := get(response,"_status",0)
    if type(status) != "int" || status < 100 || status > 599 {
        return {"ok":false,"message":"Z.ai returned an invalid HTTP status."}
    }
    body := get(response,"_body",null)
    if type(body) != "string" || byte_length(body) > BODY_LIMIT {
        return {"ok":false,"status_code":status,"message":"Z.ai returned an invalid or oversized HTTP body."}
    }
    data := redact_value(decode_json(body),key)
    if status < 200 || status > 299 || provider_error(data) {
        return {"ok":false,"status_code":status,"data":data,"message":failure_message(data)}
    }
    if streaming {
        parsed := parse_stream_impl([],body)
        if !parsed["ok"] || !parsed["complete"] || len(parsed["events"]) == 0 {
            return {"ok":false,"status_code":status,"message":"Z.ai returned an incomplete or invalid stream."}
        }
        events := redact_value(parsed["events"],key)
        for event in events {
            if provider_error(event) {
                return {"ok":false,"status_code":status,"data":event,"message":failure_message(event)}
            }
        }
        return {"ok":true,"status_code":status,"data":null,"events":events}
    }
    if type(data) != "dict" {
        return {"ok":false,"status_code":status,"message":"Z.ai returned a malformed JSON response."}
    }
    return {"ok":true,"status_code":status,"data":data}
}

func parse_stream_impl(chunks, body) {
    failed := {"ok":false,"events":[],"complete":false}
    combined := body
    if type(chunks) == "array" && len(chunks) > 0 {
        if len(chunks) > 65536 { return failed }
        size := 0
        for chunk in chunks {
            if type(chunk) != "string" { return failed }
            size = size + byte_length(chunk)
            if size > BODY_LIMIT { return failed }
        }
        combined = join(chunks,"")
    }
    if type(combined) != "string" || byte_length(combined) > BODY_LIMIT { return failed }
    if contains(combined,"\r") > 0 { combined = replace(replace(combined,"\r\n","\n"),"\r","\n") }

    blocks := split(combined,"\n\n")
    if len(blocks) > 65536 { return failed }
    events := range(0,len(blocks))
    count := 0
    complete := false
    for block in blocks {
        data := ""
        if starts_with(block,"data:") && contains(block,"\n") == 0 {
            data = trim(substring(block,5,len(block)))
        } else {
            lines := []
            for line in split(block,"\n") {
                if starts_with(line,"data:") { lines = push(lines,substring(line,5,len(line))) }
            }
            data = trim(join(lines,"\n"))
        }
        if data == "" { continue }
        if complete { return failed }
        if data == "[DONE]" { complete = true; continue }
        event := decode_json(data)
        if type(event) != "dict" { return failed }
        events[count] = event
        count = count + 1
    }
    return {"ok":true,"events":slice(events,0,count),"complete":complete}
}

export create_client := create_client_impl
export chat := chat_impl
export parse_stream := parse_stream_impl
export zai_base := ZAI_BASE
export zai_default_model := DEFAULT_MODEL
export zai_endpoint := endpoint
export zai_provider_error := provider_error
export zai_failure_message := failure_message
